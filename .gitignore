.env
.venv/
__pycache__/
*.pyc
.DS_Store
app.py.bak
app.py.embedfix.bak
*.bak
uvicorn.log*
training_data/
runs/
weights/

# Acceptance recordings. Served over /static/recordings so a drive can be
# LISTENED to -- which is the only way some of these failures are visible at
# all -- but they are tens of megabytes of WAV per pass and they are evidence
# of one run, not part of the project. The report carries the URLs.
static/recordings/

# Local Claude Code settings — per-machine, not part of the project
.claude/

# Git credential store — lives at /workspace/.git-credentials, OUTSIDE this
# repo, so it survives a container rebuild and git cannot stage it. This line
# only guards against a stray copy ever landing inside the worktree.
.git-credentials

# The spoken question tools/voice_latency.py feeds to the detector. Synthesised
# once and cached so every run measures against the same recording; it is a
# derived artifact, not a fixture, and re-makes itself on a fresh checkout.
tools/_driver_*.pcm

# Cached driver audio for the live benches. Synthesised on demand and
# deterministic per question; there is no reason to carry it in the repo.
tools/_live_cache/
